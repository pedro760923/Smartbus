<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartBus.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- EF Core InMemory: usado para dar uma implementação real de
         IApplicationDbContext aos services em teste. Mockar DbSet<T>
         diretamente é frágil e testa detalhe de implementação do EF,
         não a regra de negócio — InMemory é o padrão pragmático aqui. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartBus.Domain\SmartBus.Domain.csproj" />
    <ProjectReference Include="..\..\src\SmartBus.Application\SmartBus.Application.csproj" />
    <ProjectReference Include="..\..\src\SmartBus.Infrastructure\SmartBus.Infrastructure.csproj" />
  </ItemGroup>

</Project>
