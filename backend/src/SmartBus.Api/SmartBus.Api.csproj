  <ItemGroup>
    <ProjectReference Include="..\SmartBus.Application\SmartBus.Application.csproj" />
    <ProjectReference Include="..\SmartBus.Infrastructure\SmartBus.Infrastructure.csproj" />
  </ItemGroup>

</Project>
